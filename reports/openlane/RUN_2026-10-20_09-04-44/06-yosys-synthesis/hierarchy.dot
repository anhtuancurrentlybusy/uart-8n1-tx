digraph "uart_tx_top" {
label="uart_tx_top";
rankdir="LR";
remincross=true;
n1 [ shape=diamond, label="shift_bit1", color="black", fontcolor="black"];
n2 [ shape=diamond, label="shift_bit0", color="black", fontcolor="black"];
n3 [ shape=diamond, label="shift_en", color="black", fontcolor="black"];
n4 [ shape=diamond, label="shift_load", color="black", fontcolor="black"];
n5 [ shape=diamond, label="bit_last", color="black", fontcolor="black"];
n6 [ shape=diamond, label="bit_inc", color="black", fontcolor="black"];
n7 [ shape=diamond, label="bit_clear", color="black", fontcolor="black"];
n8 [ shape=diamond, label="baud_clear", color="black", fontcolor="black"];
n9 [ shape=diamond, label="baud_tick", color="black", fontcolor="black"];
n10 [ shape=octagon, label="busy", color="black", fontcolor="black"];
n11 [ shape=octagon, label="tx", color="black", fontcolor="black"];
n12 [ shape=octagon, label="data_in", color="black", fontcolor="black"];
n13 [ shape=octagon, label="valid_in", color="black", fontcolor="black"];
n14 [ shape=octagon, label="rst_n", color="black", fontcolor="black"];
n15 [ shape=octagon, label="clk", color="black", fontcolor="black"];
c16 [ shape=record, label="{{<p9> baud_tick|<p5> bit_last|<p15> clk|<p14> rst_n|<p2> shift_bit0|<p1> shift_bit1|<p13> valid_in}|u_tx_controller\nuart_tx_controller|{<p8> baud_clear|<p7> bit_clear|<p6> bit_inc|<p10> busy|<p3> shift_en|<p4> shift_load|<p11> tx}}",  ];
c18 [ shape=record, label="{{<p15> clk|<p12> data_in|<p17> load|<p14> rst_n|<p3> shift_en}|u_tx_shift_register\nuart_tx_shift_register|{<p2> shift_bit0|<p1> shift_bit1}}",  ];
c21 [ shape=record, label="{{<p19> clear|<p15> clk|<p20> increment|<p14> rst_n}|u_bit_counter\nuart_bit_counter|{<p5> bit_last}}",  ];
c23 [ shape=record, label="{{<p19> clear|<p15> clk|<p14> rst_n}|u_baud_counter\n$paramod&#9586;uart_baud_counter&#9586;CLKS_PER_BIT=s32'00000000000000000000000000010000|{<p22> tick}}",  ];
c18:p1:e -> n1:w [color="black", fontcolor="black", label=""];
n1:e -> c16:p1:w [color="black", fontcolor="black", label=""];
c16:p10:e -> n10:w [color="black", fontcolor="black", label=""];
c16:p11:e -> n11:w [color="black", fontcolor="black", label=""];
n12:e -> c18:p12:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n13:e -> c16:p13:w [color="black", fontcolor="black", label=""];
n14:e -> c16:p14:w [color="black", fontcolor="black", label=""];
n14:e -> c18:p14:w [color="black", fontcolor="black", label=""];
n14:e -> c21:p14:w [color="black", fontcolor="black", label=""];
n14:e -> c23:p14:w [color="black", fontcolor="black", label=""];
n15:e -> c16:p15:w [color="black", fontcolor="black", label=""];
n15:e -> c18:p15:w [color="black", fontcolor="black", label=""];
n15:e -> c21:p15:w [color="black", fontcolor="black", label=""];
n15:e -> c23:p15:w [color="black", fontcolor="black", label=""];
c18:p2:e -> n2:w [color="black", fontcolor="black", label=""];
n2:e -> c16:p2:w [color="black", fontcolor="black", label=""];
c16:p3:e -> n3:w [color="black", fontcolor="black", label=""];
n3:e -> c18:p3:w [color="black", fontcolor="black", label=""];
c16:p4:e -> n4:w [color="black", fontcolor="black", label=""];
n4:e -> c18:p17:w [color="black", fontcolor="black", label=""];
c21:p5:e -> n5:w [color="black", fontcolor="black", label=""];
n5:e -> c16:p5:w [color="black", fontcolor="black", label=""];
c16:p6:e -> n6:w [color="black", fontcolor="black", label=""];
n6:e -> c21:p20:w [color="black", fontcolor="black", label=""];
c16:p7:e -> n7:w [color="black", fontcolor="black", label=""];
n7:e -> c21:p19:w [color="black", fontcolor="black", label=""];
c16:p8:e -> n8:w [color="black", fontcolor="black", label=""];
n8:e -> c23:p19:w [color="black", fontcolor="black", label=""];
c23:p22:e -> n9:w [color="black", fontcolor="black", label=""];
n9:e -> c16:p9:w [color="black", fontcolor="black", label=""];
}
