VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO uart_tx_top
  CLASS BLOCK ;
  FOREIGN uart_tx_top ;
  ORIGIN 0.000 0.000 ;
  SIZE 58.390 BY 69.110 ;
  PIN VGND
